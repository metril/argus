+/// Resolve `uri`'s host through the client's DNS resolver and return a URI whose authority is
+/// the first resolved `ip:port`, for use as the HTTP CONNECT target.
+async fn resolve_connect_target(resolver: &DynResolver, uri: &Uri) -> Result<Uri, BoxError> {
+    let host = uri.host().ok_or("URI missing host")?;
+    let port = uri.port_or_default();
+    let literal = host.trim_start_matches('[').trim_end_matches(']');
+
+    let ip = match literal.parse::<IpAddr>() {
+        Ok(ip) => ip,
+        Err(_) => {
+            let mut addrs = resolver.clone().call(Name::from(host)).await?;
+            addrs
+                .next()
+                .ok_or_else(|| BoxError::from(format!("no addresses resolved for {host}")))?
+                .ip()
+        }
+    };
+
+    let authority = match ip {
+        IpAddr::V4(ip) => format!("{ip}:{port}"),
+        IpAddr::V6(ip) => format!("[{ip}]:{port}"),
+    };
+    Uri::builder()
+        .scheme("http")
+        .authority(authority)
+        .path_and_query("/")
+        .build()
+        .map_err(Into::into)
+}
